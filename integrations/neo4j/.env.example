# Neo4j connection settings for the research-intelligence graph.
# Copy this file to .env (same folder) and fill in real values.
# .env is git-ignored and never committed.

NEO4J_URI=http://localhost:7474
NEO4J_USER=neo4j
# Leave blank to be prompted at connect time. Do not commit a real password.
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4jintegrations/neo4j/.env.example